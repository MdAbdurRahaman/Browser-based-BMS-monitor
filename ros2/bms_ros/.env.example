# Copy this file to .env and edit. Leave a value empty (or "auto") to detect it automatically.
# .env is looked for in: the current folder, ros2/bms_ros/, the repository root,
# or the path in the BMS_ENV_FILE environment variable.

# Serial port: COM26 on Windows, /dev/ttyUSB0 or /dev/serial/by-id/... on Linux.
# If this port is missing or silent, every USB serial adapter is tried instead.
BMS_PORT=

# daly or jbd (empty = try both)
BMS_PROTOCOL=

BMS_BAUD=9600
# polls per second
BMS_RATE=1.0
# seconds to wait for each reply
BMS_TIMEOUT=0.6
